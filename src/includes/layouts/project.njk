<!DOCTYPE html>
<html lang="en">
<head>
    {% include "partials/head.njk" %}
    {% set projectSchema = {
      "@context": "https://schema.org",
      "@type": "CreativeWork",
      "@id": meta.baseURL + page.url,
      "name": title,
      "description": intro,
      "image": meta.baseURL + socialCards[thumbnail] if thumbnail else meta.baseURL + meta.image,
      "isPartOf": { "@id": meta.baseURL + "/#website" },
      "creator": {
        "@type": "Role",
        "roleName": role,
        "creator": { "@id": meta.baseURL + "/#person" }
      }
    } %}
    <script type="application/ld+json">{{ projectSchema | dump | safe }}</script>
</head>
<body class="page-project">

    {% include "partials/header.njk" %}

    <main id="main">

        <div class="layout">

            <h1 class="page-title">{{ title }}</h1>

            {{ content | safe }}

        </div>

    </main>

    <nav class="projects" aria-labelledby="project-pagination">

    <div class="layout">

        <h2 class="projects__heading" id="project-pagination">Projects</h2>

        {% set navPages = collections.project | eleventyNavigation %}
        <ol>
            {%- for entry in navPages %}
            <li{% if entry.url == page.url %} aria-current="page" class="current"{% endif %}>
                <a href="{{ entry.url | url }}">{{ entry.title }}</a>
            </li>
            {%- endfor %}
        </ol>

        </div>

    </nav>

    {% include "partials/footer.njk" %}

</body>
</html>