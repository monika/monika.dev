<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">

<meta name="viewport" content="width=device-width, initial-scale=1">

<title>{% if title != "Home" %}{{ title }} | {% endif %}{{ meta.title }}</title>

<meta name="description" content="{{ intro if intro else meta.description }}">

<meta name="robots" content="{% if noindex %}noindex,nofollow{% else %}index,follow{% endif %}">
<meta name="generator" content="Eleventy">

<link rel="canonical" href="{{ meta.baseURL }}{{ page.url }}">

{% include "partials/meta.njk" %}
{% include "partials/structured-data.njk" %}

{% if isProduction %}<link rel="dns-prefetch" href="https://www.googletagmanager.com">{% endif %}
<link rel="preconnect" href="https://use.typekit.net">
<link rel="dns-prefetch" href="https://use.typekit.net">

{# Body copy is self-hosted, so preload it — it's needed for first paint. #}
<link rel="preload" href="/fonts/fira-sans-300.woff2" as="font" type="font/woff2" crossorigin>

{# Display faces (Obviously) stay on Adobe Fonts — their license doesn't permit
   self-hosting. Loaded async so they don't block first paint.

   `media="print"` is what makes it non-blocking, but it also drops the request
   to low priority, and the font files themselves aren't discovered until this
   stylesheet has arrived and parsed. The preload restores high priority so that
   two-step chain starts immediately instead of after the rest of the page. #}
<link rel="preload" href="https://use.typekit.net/izf4qqb.css" as="style">
<link rel="stylesheet" href="https://use.typekit.net/izf4qqb.css" media="print" onload="this.media='all';this.onload=null">
<noscript><link rel="stylesheet" href="https://use.typekit.net/izf4qqb.css"></noscript>

{# Compiled and compressed in eleventy.config.mjs — normalize and the site
   styles arrive as one bundle. #}
<style>{{ css | safe }}</style>

{# The syntax highlighting theme follows the main bundle so its token colours
   win, and only on the pages that actually rendered a code block. #}
{% if content | hasHighlightedCode %}<style>{{ prismCss | safe }}</style>{% endif %}

<link rel="icon" type="image/png" sizes="512x512" href="/favicon.png">
<link rel="apple-touch-icon" href="/favicon.png">
<link rel="manifest" href="/site.webmanifest">
<meta name="theme-color" content="#0000ff">

{# Search Console only reads these from the homepage. #}
{% if title === "Home" %}<meta name="google-site-verification" content="PS4Kd7aa-5zazVKHNptpocJ7eT-B3O1UypqytvvyJEc" />
<meta name="google-site-verification" content="5xNJk3VTtNa-uEF8lYP5fbnoHMbiJmL6sfOE6dJeptY" />{% endif %}