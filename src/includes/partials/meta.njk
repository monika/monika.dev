{# Prefer the page's own title/intro so a shared project link doesn't preview
   identically to the homepage. #}
{%- set pageTitle = meta.title if title == "Home" else title + " | " + meta.name -%}
{%- set pageDescription = intro if intro else meta.description -%}
{%- set isArticle = tags and ("project" in tags or "caseStudy" in tags) -%}

{# Projects use a -social crop, generated at 1200x630 in the gulp image task:
   the raw thumbnails are full-page screenshots, so they're cropped to card
   ratio from the top, which lands on each site's hero. Everything else falls
   back to the generic card. #}
{%- set socialImage = meta.baseURL + "/images/" + thumbnail + "-social.jpg" if thumbnail else meta.baseURL + meta.image -%}
{%- set socialImageAlt = thumbnailAlt if thumbnailAlt else meta.name + " — " + meta.jobTitle -%}

<!-- Facebook OpenGraph -->
<meta property="og:url" content="{{ meta.baseURL }}{{ page.url }}">
<meta property="og:type" content="{{ "article" if isArticle else "website" }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDescription }}">
<meta property="og:site_name" content="{{ meta.name }}">
<meta property="og:image" content="{{ socialImage }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ socialImageAlt }}">
<meta property="og:locale" content="en_US">
{% if isArticle %}<meta property="article:author" content="{{ meta.baseURL }}">{% endif %}

<!-- X / Twitter -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ pageTitle }}">
<meta name="twitter:description" content="{{ pageDescription }}">
<meta name="twitter:image" content="{{ socialImage }}">
<meta name="twitter:image:alt" content="{{ socialImageAlt }}">
