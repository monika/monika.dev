---
title: Home
---

<!DOCTYPE html>
<html lang="en">
<head>
    {% include "partials/head.njk" %}
</head>
<body class="page-home">

    {% include "partials/header.njk" %}

    <main id="main">

        <div id="projects" class="projects">
        <div class="layout">

            <h2 class="projects__heading">Project Archive</h2>
            <p class="projects__intro">Selected freelance and agency work, 2004–2020.</p>

            <!-- Three new projects -->
            {%- for project in collections.projectListing -%}
            <article class="project">

                <figure class="project__thumbnail">
                    <picture class="project__mask">
                        <source
                            type="image/webp"
                            srcset="/images/{{ project.data.thumbnail }}-small.webp 200w,
                                    /images/{{ project.data.thumbnail }}-medium.webp 400w,
                                    /images/{{ project.data.thumbnail }}-large.webp 800w"
                            sizes="(max-width: 648px) 76vw, 45vw"
                        />
                        <img
                            class="project__image"
                            srcset="/images/{{ project.data.thumbnail }}-small.jpg 200w,
                                    /images/{{ project.data.thumbnail }}-medium.jpg 400w,
                                    /images/{{ project.data.thumbnail }}-large.jpg 800w"
                            sizes="(max-width: 648px) 76vw, 45vw"
                            src="/images/{{ project.data.thumbnail }}-large.jpg"
                            alt="{{ project.data.thumbnailAlt }}"
                            loading="lazy"
                            decoding="async"
                        />
                    </picture>
                </figure>

                <div class="project__content">

                    <h3 class="project__title">{{ project.data.title }}</h3>
                    <p class="project__role">{{ project.data.role }}</p>
                    <p class="project__info">{{ project.data.intro }}</p>
                    <a class="project__link button" href="{{ project.url }}">Review Project</a>

                </div>

            </article>
            {%- endfor -%}

        </div>
        </div>

    </main>

    {% include "partials/footer.njk" %}

</body>
</html>
