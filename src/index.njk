---
title: Home
---

<!DOCTYPE html>
<html lang="en">
<head>
    {% include "partials/head.njk" %}
</head>
<body class="page-home">

    {% include "partials/header.njk" %}

    <main id="main">

        {# Written out by hand rather than looped over a collection. There are two
           of them, they change when Monika changes them, and the markup is easier
           to read than the template that would generate it. Add a case study by
           copying an <article> block. #}
        <div id="case-studies" class="case-studies">
        <div class="layout">

            <h2 class="case-studies__heading">Case Studies</h2>
            <p class="case-studies__intro">Selected in-house work at AdRoll, 2020&ndash;2026. Full case studies available upon request.</p>

            <article class="case-study-card">

                <p class="case-study-card__eyebrow">AdRoll</p>
                <h3 class="case-study-card__title">GEO / AEO Authority Pilot</h3>
                <p class="case-study-card__role">Technical SEO, Content Strategy, Web Development</p>

                <p class="case-study-card__intro">Applied structured entity data (Schema.org / JSON-LD) and hub-and-spoke internal linking to a content cluster, validated against a control group with a Difference-in-Differences framework. Result: +11.75% organic lift from structure alone, +24.1% with verified entity authorship added; average search position improved from 24.27 to 18.43.</p>

                <ul class="case-study-card__tags">
                    <li class="case-study-card__tag">Answer engine optimization</li>
                    <li class="case-study-card__tag">Structured data</li>
                    <li class="case-study-card__tag">Entity authorship</li>
                    <li class="case-study-card__tag">Technical SEO</li>
                </ul>

                <p class="case-study-card__gated">Full case study available upon request: <a href="mailto:monika@monika.dev?subject=GEO%20%2F%20AEO%20Authority%20Pilot">monika@monika.dev</a></p>

            </article>

            <article class="case-study-card">

                <p class="case-study-card__eyebrow">AdRoll</p>
                <h3 class="case-study-card__title">Sitewide Search &mdash; Analytics &amp; Content Insight</h3>
                <p class="case-study-card__role">Web Design &amp; Development</p>

                <p class="case-study-card__intro">Conceived, built, and owned AdRoll.com&rsquo;s Algolia sitewide search and its weekly reporting program &mdash; 9,400+ searches analyzed over 13 weeks, surfacing content gaps and high-intent demand for content, revenue marketing, and product marketing teams. Curated the default search menu to route users toward high-intent pages (95% of empty-state clicks land in the top six results).</p>

                <ul class="case-study-card__tags">
                    <li class="case-study-card__tag">Site search</li>
                    <li class="case-study-card__tag">Interface design</li>
                    <li class="case-study-card__tag">Search analytics</li>
                    <li class="case-study-card__tag">Front-end development</li>
                </ul>

                <p class="case-study-card__gated">Full case study available upon request: <a href="mailto:monika@monika.dev?subject=Sitewide%20Search">monika@monika.dev</a></p>

            </article>

        </div>
        </div>

        <div id="projects" class="projects">
        <div class="layout">

            <h2 class="projects__heading">Project Archive</h2>
            <p class="projects__intro">Selected freelance and agency work, 2004–2020.</p>

            <!-- Three new projects -->
            {%- for project in collections.projectListing -%}
            <article class="project">

                <figure class="project__thumbnail">
                    <picture class="project__mask">
                        <source
                            type="image/webp"
                            srcset="/images/{{ project.data.thumbnail }}-small.webp 200w,
                                    /images/{{ project.data.thumbnail }}-medium.webp 400w,
                                    /images/{{ project.data.thumbnail }}-large.webp 800w"
                            sizes="(max-width: 648px) 76vw, 45vw"
                        />
                        <img
                            class="project__image"
                            srcset="/images/{{ project.data.thumbnail }}-small.jpg 200w,
                                    /images/{{ project.data.thumbnail }}-medium.jpg 400w,
                                    /images/{{ project.data.thumbnail }}-large.jpg 800w"
                            sizes="(max-width: 648px) 76vw, 45vw"
                            src="/images/{{ project.data.thumbnail }}-large.jpg"
                            alt="{{ project.data.thumbnailAlt }}"
                            loading="lazy"
                            decoding="async"
                        />
                    </picture>
                </figure>

                <div class="project__content">

                    <h3 class="project__title">{{ project.data.title }}</h3>
                    <p class="project__role">{{ project.data.role }}</p>
                    <p class="project__info">{{ project.data.intro }}</p>
                    <a class="project__link button" href="{{ project.url }}">Review Project</a>

                </div>

            </article>
            {%- endfor -%}

        </div>
        </div>

    </main>

    {% include "partials/footer.njk" %}

</body>
</html>
