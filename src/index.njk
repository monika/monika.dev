---
title: Home
---

<!DOCTYPE html>
<html lang="en">
<head>
    {% include "partials/head.njk" %}
</head>
<body class="page-home">

    {% include "partials/header.njk" %}

    <main id="main">

        <div id="case-studies" class="case-studies">
        <div class="layout">

            <h2 class="case-studies__heading">Case Studies</h2>
            <p class="case-studies__intro">Selected in-house work at AdRoll, 2020&ndash;2026.</p>

            {%- for study in collections.caseStudyListing %}
            <article class="case-study-card">

                <h3 class="case-study-card__title">{{ study.data.title }}</h3>
                <p class="case-study-card__role">{{ study.data.role }}</p>

                <p>{{ study.data.cardDescription or study.data.intro }}</p>
                {% if study.data.cardResult %}<p>{{ study.data.cardResult }}</p>{% endif %}

                <ul class="case-study-card__tags">
                    {%- for tag in study.data.cardTags or study.data.about %}
                    <li class="case-study-card__tag">{{ tag }}</li>
                    {%- endfor %}
                </ul>

                <a class="case-study-card__link button" href="{{ study.url }}">Read Case Study</a>

            </article>
            {%- endfor %}

        </div>
        </div>

        <div id="projects" class="projects">
        <div class="layout">

            <h2 class="projects__heading">Project Archive</h2>
            <p class="projects__intro">Selected freelance and agency work, 2004–2020.</p>

            <!-- Three new projects -->
            {%- for project in collections.projectListing -%}
            <article class="project">

                <figure class="project__thumbnail">
                    {% image project.data.thumbnail, project.data.thumbnailAlt, "(max-width: 648px) 76vw, 45vw", "project__mask", "project__image" %}
                </figure>

                <div class="project__content">

                    <h3 class="project__title">{{ project.data.title }}</h3>
                    <p class="project__role">{{ project.data.role }}</p>
                    <p class="project__info">{{ project.data.intro }}</p>
                    <a class="project__link button" href="{{ project.url }}">Review Project</a>

                </div>

            </article>
            {%- endfor -%}

        </div>
        </div>

    </main>

    {% include "partials/footer.njk" %}

</body>
</html>
